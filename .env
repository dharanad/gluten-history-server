# Read by docker compose automatically. Shell exports override these.
# EVENT_LOG_DIR is resolved inside the container, not on the host: use file:///opt/event-logs
# (where ./event-logs is mounted) or a gs://bucket/path. A relative path like ./event-logs fails.
EVENT_LOG_DIR=file:///opt/event-logs
# Image for ./setup.sh --publish / --pull (Docker Hub: <user>/<repo>:<tag>; log in with `docker login`).
IMAGE=dharanaditya/gluten-history-server:latest
