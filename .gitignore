# Keep the directories (via .gitkeep), ignore their contents.
# Extracted Spark distribution(s): download and extract the tarball (see README)
dist/*
!dist/.gitkeep

# Event logs to browse (local only)
event-logs/*
!event-logs/.gitkeep

# Spark tarball: downloaded from archive.apache.org (see README); only its .sha512 is committed
spark-*.tgz

# Gluten bundle: built and updated outside this repo; drop it into jars/
jars/gluten-*.jar

.DS_Store
