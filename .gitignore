# Keep the directories (via .gitkeep), ignore their contents.
# Spark distribution: installed by setup.sh
dist/*
!dist/.gitkeep

# Event logs to browse (local only)
event-logs/*
!event-logs/.gitkeep

# Spark tarball and checksum, if downloaded by hand
spark-*.tgz
spark-*.tgz.sha512

# Gluten bundle: built and updated outside this repo; drop it into jars/
jars/gluten-*.jar

.DS_Store
